# OpenAI (solo servidor)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TRANSLATION_MODEL=gpt-4o-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# Secreto independiente para firmar sesiones y credenciales de dispositivo. Mínimo 32 caracteres.
AUTH_SECRET=
PUBLIC_BASE_URL=https://asistente-onoff.vercel.app

# Acceso del panel privado /admin
ADMIN_USERNAME=
# Recomendado: use ADMIN_PASSWORD_HASH y deje ADMIN_PASSWORD vacío.
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=

# Activación por dispositivo
EXTENSION_SESSION_SECONDS=3600
DEVICE_ENROLLMENT_SECONDS=600
DEVICE_REFRESH_DAYS=180
# Si la extensión se distribuye empaquetada con ID estable, puede restringir IDs separados por coma.
# Para extensiones desempaquetadas/reinstalables, deje vacío para evitar bloqueos por cambio de ID.
ALLOWED_EXTENSION_IDS=
ALLOWED_ORIGINS=

# Bitrix (solo servidor)
BITRIX_WEBHOOK_URL=
BITRIX_TC_FIELD=UF_CRM_1642606760058
BITRIX_IDENTIFICATION_FIELD=UF_CRM_1599251398

# Vercel Blob privado: guarda configuración y registro de dispositivos
BLOB_READ_WRITE_TOKEN=
