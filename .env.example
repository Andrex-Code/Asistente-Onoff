OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TRANSLATION_MODEL=gpt-4o-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# Panel privado /admin
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=
AUTH_SECRET=
BLOB_READ_WRITE_TOKEN=

# Solo servidor. Nunca incluir la URL privada en la extension.
BITRIX_WEBHOOK_URL=
BITRIX_TC_FIELD=UF_CRM_1642606760058

# Opcional. Prioridad: IDs de usuarios > IDs de departamentos > nombres.
# Usar IDs reales, separados por comas. No usar nombres de ejemplo.
BITRIX_SAC_OWNER_IDS=
BITRIX_SAC_DEPARTMENT_IDS=
BITRIX_SAC_DEPARTMENT_NAMES=SAC|Servicio al cliente
