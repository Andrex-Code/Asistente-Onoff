# OpenAI (solo servidor)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TRANSLATION_MODEL=gpt-4o-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# Secreto independiente para firmar sesiones. Mínimo 32 caracteres.
AUTH_SECRET=
PUBLIC_BASE_URL=https://asistente-onoff.vercel.app

# Acceso del panel privado /admin
ADMIN_USERNAME=
# Recomendado: use ADMIN_PASSWORD_HASH y deje ADMIN_PASSWORD vacío.
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=

# Acceso de la extensión. Genere el hash con: npm run hash-password -- "contraseña"
EXTENSION_USERNAME=
EXTENSION_PASSWORD_HASH=
# Alternativa para varios usuarios: {"asesor1":"pbkdf2_sha256$...","asesor2":"pbkdf2_sha256$..."}
EXTENSION_USERS_JSON=
EXTENSION_SESSION_SECONDS=28800
# Recomendado en producción: IDs separados por coma obtenidos de chrome://extensions o edge://extensions
ALLOWED_EXTENSION_IDS=
# Solo para orígenes web adicionales controlados, separados por coma.
ALLOWED_ORIGINS=

# Bitrix (solo servidor)
BITRIX_WEBHOOK_URL=
BITRIX_TC_FIELD=UF_CRM_1642606760058
BITRIX_IDENTIFICATION_FIELD=UF_CRM_1599251398

# Vercel Blob privado
BLOB_READ_WRITE_TOKEN=
