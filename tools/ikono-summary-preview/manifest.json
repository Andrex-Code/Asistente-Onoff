{
  "manifest_version": 3,
  "name": "ONOFF · Chats y tipificaciones",
  "version": "0.22.0",
  "description": "Resumen por chat y piloto de tarea PRUEBA tras cierre humano verificado. Confirmación de TC y revisión obligatorias.",
  "permissions": [
    "activeTab",
    "scripting",
    "offscreen",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://asistente-onoff.vercel.app/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "action": {
    "default_title": "Abrir vista previa de resumen"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://onoff.a.ikono.im/*",
        "https://onoff.s.ikono.im/*"
      ],
      "js": [
        "guard.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://onoff.a.ikono.im/*",
        "https://onoff.s.ikono.im/*"
      ],
      "js": [
        "move.js",
        "timeline.js",
        "memory.js",
        "classification.js",
        "probe.js",
        "tc.js",
        "image-evidence.js",
        "images.js",
        "auto.js",
        "task.js",
        "advisor.js",
        "closure.js",
        "task-create.js",
        "dashboard.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
