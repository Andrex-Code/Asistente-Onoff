{
  "manifest_version": 3,
  "name": "ONOFF · Chats y tipificaciones",
  "version": "0.12.0",
  "description": "Resumen por chat y vista previa revisada. Sin creación de tareas Bitrix ni cierre automático.",
  "permissions": [
    "activeTab",
    "scripting",
    "offscreen"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "action": {
    "default_title": "Abrir vista previa de resumen"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://onoff.a.ikono.im/*",
        "https://onoff.s.ikono.im/*"
      ],
      "js": [
        "guard.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://onoff.a.ikono.im/*",
        "https://onoff.s.ikono.im/*"
      ],
      "js": [
        "memory.js",
        "classification.js",
        "probe.js",
        "tc.js",
        "image-evidence.js",
        "images.js",
        "auto.js",
        "task.js",
        "dashboard.js"
      ],
      "run_at": "document_idle"
    }
  ]
}