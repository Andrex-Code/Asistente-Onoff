{
  "manifest_version": 3,
  "name": "ONOFF · Vista previa de resumen",
  "version": "0.5.0",
  "description": "Captura revisada, tipificación y borrador IA autorizado. Sin tareas Bitrix ni cierre automático.",
  "permissions": ["activeTab", "scripting"],
  "action": {"default_title": "Abrir vista previa de resumen"},
  "background": {"service_worker": "background.js"},
  "content_scripts": [{"matches":["https://onoff.a.ikono.im/*","https://onoff.s.ikono.im/*"],"js":["classification.js","probe.js","auto.js"],"run_at":"document_idle"}]
}
