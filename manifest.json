{
  "manifest_version": 3,
  "name": "Asistente ONOFF",
  "version": "1.1.0",
  "description": "Asistente para iKono: traducción PT-BR, mejora de textos, audio, plantillas Bitrix y seguimientos.",
  "permissions": ["contextMenus", "storage", "activeTab", "scripting", "tabs"],
  "host_permissions": [
    "<all_urls>",
    "https://*.vercel.app/*",
    "http://localhost:3000/*",
    "https://api.mymemory.translated.net/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/*.svg", "icons/*.png"],
      "matches": ["<all_urls>"]
    }
  ],
  "options_page": "src/options.html",
  "action": {
    "default_title": "Asistente ONOFF",
    "default_popup": "src/popup.html"
  }
}
